/* ==========================================================================
   TJAC BI Dashboard — Design System 2.0
   Visual: Corporate / Institutional / Premium / Minimal
   Plataforma: Streamlit
   ========================================================================== */

/* ==========================================================================
   1. DESIGN TOKENS
   ========================================================================== */

:root {
    /* Cores principais */
    --primary: #1f4e79;
    --primary-dark: #173a5c;
    --primary-light: #3b6f9f;
    --primary-soft: #eaf2f8;

    /* Superfícies */
    --background: #f4f6f8;
    --surface: #ffffff;
    --surface-subtle: #f8fafc;
    --surface-hover: #f5f8fb;

    /* Texto */
    --text-primary: #17202a;
    --text-secondary: #52606d;
    --text-muted: #7b8794;
    --text-on-primary: #ffffff;

    /* Bordas */
    --border: #dfe5eb;
    --border-light: #e9eef3;
    --border-focus: #7da5c7;

    /* Estados */
    --success: #23865b;
    --success-soft: #eaf7f0;
    --warning: #b7791f;
    --warning-soft: #fff7e6;
    --danger: #b84242;
    --danger-soft: #fceeee;
    --info: #2d6fa3;
    --info-soft: #edf5fb;

    /* KPI */
    --kpi-blue: #2f6fab;
    --kpi-green: #27845b;
    --kpi-teal: #247d8a;
    --kpi-orange: #b7791f;
    --kpi-violet: #6654a6;

    /* Tipografia */
    --font-family: "Outfit", -apple-system, BlinkMacSystemFont, "Segoe UI",
        Roboto, Helvetica, Arial, sans-serif;

    /* Raios */
    --radius-sm: 6px;
    --radius-md: 9px;
    --radius-lg: 12px;
    --radius-xl: 14px;

    /* Sombras */
    --shadow-xs: 0 1px 2px rgba(15, 23, 42, 0.04);
    --shadow-sm: 0 2px 8px rgba(15, 23, 42, 0.06);
    --shadow-md: 0 6px 18px rgba(15, 23, 42, 0.08);

    /* Espaçamento */
    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-5: 20px;
    --space-6: 24px;
    --space-8: 32px;
}

/* ==========================================================================
   2. RESET E BASE
   ========================================================================== */

html,
body,
[class*="css"] {
    font-family: var(--font-family) !important;
}

.stApp {
    background: var(--background) !important;
    color: var(--text-primary);
    min-height: 100vh;
}

.block-container {
    padding-top: 1.5rem;
    padding-bottom: 2.5rem;
}

::selection {
    background: rgba(31, 78, 121, 0.18);
    color: var(--text-primary);
}

/* ==========================================================================
   3. HEADER / TÍTULO PRINCIPAL
   ========================================================================== */

.main-header {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 22px 28px;
    margin-bottom: var(--space-6);
    box-shadow: var(--shadow-sm);
    position: relative;
    overflow: hidden;
}

.main-header::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: var(--primary);
}

.main-header h1 {
    font-size: 1.85rem;
    font-weight: 700;
    color: var(--text-primary) !important;
    margin: 0 0 5px 0;
    letter-spacing: -0.025em;
    line-height: 1.2;
}

.main-header p {
    color: var(--text-secondary);
    font-size: 0.92rem;
    margin: 0;
    font-weight: 400;
    line-height: 1.5;
}

.main-header .badge {
    display: inline-flex;
    align-items: center;
    background: var(--primary-soft);
    border: 1px solid #d3e2ef;
    color: var(--primary-dark);
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 600;
    margin-top: 10px;
    letter-spacing: 0.045em;
    text-transform: uppercase;
}

/* ==========================================================================
   4. KPI GRID
   ========================================================================== */

.kpi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-6);
}

.kpi-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 19px 20px;
    position: relative;
    overflow: hidden;
    box-shadow: var(--shadow-xs);
    transition:
        box-shadow 0.2s ease,
        border-color 0.2s ease,
        transform 0.2s ease;
    cursor: default;
}

.kpi-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: #cbd6e0;
}

.kpi-card::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 3px;
}

.kpi-card.blue::after {
    background: var(--kpi-blue);
}

.kpi-card.green::after {
    background: var(--kpi-green);
}

.kpi-card.teal::after {
    background: var(--kpi-teal);
}

.kpi-card.orange::after {
    background: var(--kpi-orange);
}

.kpi-card.violet::after {
    background: var(--kpi-violet);
}

.kpi-card .kpi-icon {
    font-size: 1.35rem;
    margin-bottom: 9px;
    display: block;
    line-height: 1;
}

.kpi-card .kpi-label {
    font-size: 0.72rem;
    color: var(--text-muted);
    font-weight: 600;
    letter-spacing: 0.045em;
    text-transform: uppercase;
    margin-bottom: 7px;
}

.kpi-card .kpi-value {
    font-size: 1.95rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.05;
    letter-spacing: -0.035em;
}

.kpi-card .kpi-sub {
    font-size: 0.76rem;
    color: var(--text-muted);
    margin-top: 7px;
}

/* ==========================================================================
   5. SIDEBAR
   ========================================================================== */

[data-testid="stSidebar"] {
    background: var(--surface) !important;
    border-right: 1px solid var(--border) !important;
}

[data-testid="stSidebar"] > div:first-child {
    background: var(--surface) !important;
}

[data-testid="stSidebar"] [data-testid="stMarkdownContainer"] p {
    color: var(--text-secondary) !important;
    font-family: var(--font-family) !important;
}

[data-testid="stSidebar"] .stSelectbox label,
[data-testid="stSidebar"] .stMultiSelect label,
[data-testid="stSidebar"] .stDateInput label {
    color: var(--text-secondary) !important;
    font-size: 0.79rem;
    font-weight: 600;
    letter-spacing: 0.02em;
}

[data-testid="stSidebar"] h1,
[data-testid="stSidebar"] h2,
[data-testid="stSidebar"] h3 {
    color: var(--text-primary) !important;
    font-family: var(--font-family) !important;
    font-size: 0.95rem !important;
    font-weight: 650 !important;
    padding-bottom: 9px;
    border-bottom: 1px solid var(--border-light);
    margin-bottom: 14px !important;
}

/* ==========================================================================
   6. TABS
   ========================================================================== */

[data-testid="stTabs"] {
    margin-bottom: var(--space-5);
}

[data-testid="stTabs"] [data-baseweb="tab-list"] {
    gap: 2px;
    background: var(--surface);
    padding: 4px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-xs);
}

[data-testid="stTabs"] [data-baseweb="tab"] {
    border-radius: var(--radius-md);
    color: var(--text-secondary);
    font-family: var(--font-family);
    font-weight: 550;
    font-size: 0.84rem;
    padding: 8px 17px;
    transition:
        background-color 0.2s ease,
        color 0.2s ease,
        box-shadow 0.2s ease;
    border: none !important;
    background: transparent;
}

[data-testid="stTabs"] [aria-selected="true"] {
    background: var(--primary) !important;
    color: var(--text-on-primary) !important;
    box-shadow: var(--shadow-sm);
}

[data-testid="stTabs"] [data-baseweb="tab"]:hover:not([aria-selected="true"]) {
    background: var(--surface-hover) !important;
    color: var(--text-primary) !important;
}

[data-testid="stTabs"] [data-baseweb="tab-highlight"] {
    background: transparent !important;
}

/* ==========================================================================
   7. TÍTULOS DE SEÇÃO
   ========================================================================== */

.section-title {
    font-size: 1rem;
    font-weight: 650;
    color: var(--text-primary);
    margin-bottom: var(--space-4);
    padding-left: 10px;
    border-left: 3px solid var(--primary);
    line-height: 1.35;
}

/* ==========================================================================
   8. GRÁFICOS / CONTENTORES
   ========================================================================== */

.chart-container {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    margin-bottom: var(--space-4);
    box-shadow: var(--shadow-xs);
    transition:
        border-color 0.2s ease,
        box-shadow 0.2s ease;
}

.chart-container:hover {
    border-color: #cbd6e0;
    box-shadow: var(--shadow-sm);
}

/* ==========================================================================
   9. BOTÕES
   ========================================================================== */

.stButton > button,
.stDownloadButton > button {
    background: var(--primary) !important;
    color: var(--text-on-primary) !important;
    border: 1px solid var(--primary) !important;
    border-radius: var(--radius-md) !important;
    font-family: var(--font-family) !important;
    font-weight: 550 !important;
    font-size: 0.84rem !important;
    min-height: 40px;
    padding: 9px 17px !important;
    transition:
        background-color 0.2s ease,
        border-color 0.2s ease,
        box-shadow 0.2s ease,
        transform 0.2s ease !important;
}

.stButton > button:hover,
.stDownloadButton > button:hover {
    background: var(--primary-dark) !important;
    border-color: var(--primary-dark) !important;
    box-shadow: var(--shadow-sm) !important;
    transform: translateY(-1px) !important;
}

.stButton > button:active,
.stDownloadButton > button:active {
    transform: translateY(0) !important;
}

.stButton > button:focus-visible,
.stDownloadButton > button:focus-visible {
    outline: 2px solid var(--border-focus) !important;
    outline-offset: 2px;
}

.stDownloadButton > button {
    width: 100% !important;
}

/* ==========================================================================
   10. DATAFRAMES / TABELAS
   ========================================================================== */

[data-testid="stDataFrame"] {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border) !important;
    box-shadow: var(--shadow-xs);
    background: var(--surface);
}

/* ==========================================================================
   11. TEXT INPUT / SEARCH
   ========================================================================== */

.stTextInput > div > div > input {
    background: var(--surface) !important;
    border: 1px solid var(--border) !important;
    border-radius: var(--radius-md) !important;
    color: var(--text-primary) !important;
    font-family: var(--font-family) !important;
    min-height: 40px;
    padding: 9px 13px !important;
    transition:
        border-color 0.2s ease,
        box-shadow 0.2s ease;
}

.stTextInput > div > div > input::placeholder {
    color: var(--text-muted) !important;
}

.stTextInput > div > div > input:hover {
    border-color: #c4d0dc !important;
}

.stTextInput > div > div > input:focus {
    border-color: var(--border-focus) !important;
    box-shadow: 0 0 0 3px rgba(31, 78, 121, 0.1) !important;
}

/* ==========================================================================
   12. SELECTBOX / MULTISELECT / DATE INPUT
   ========================================================================== */

[data-baseweb="select"] {
    border-radius: var(--radius-md) !important;
}

[data-baseweb="select"] > div {
    border-color: var(--border) !important;
    border-radius: var(--radius-md) !important;
    background: var(--surface) !important;
}

[data-baseweb="select"] > div:hover {
    border-color: #c4d0dc !important;
}

[data-baseweb="tag"] {
    background: var(--primary-soft) !important;
    border: 1px solid #d3e2ef !important;
    border-radius: var(--radius-sm) !important;
    color: var(--primary-dark) !important;
}

[data-baseweb="tag"] span {
    color: var(--primary-dark) !important;
}

/* ==========================================================================
   13. METRIC NATIVO
   ========================================================================== */

[data-testid="metric-container"] {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 16px !important;
    box-shadow: var(--shadow-xs);
}

[data-testid="metric-container"] label {
    color: var(--text-muted) !important;
    font-family: var(--font-family) !important;
    font-size: 0.78rem !important;
    font-weight: 550 !important;
}

[data-testid="metric-container"] [data-testid="stMetricValue"] {
    color: var(--text-primary) !important;
    font-family: var(--font-family) !important;
    font-weight: 700 !important;
}

[data-testid="metric-container"] [data-testid="stMetricDelta"] {
    font-family: var(--font-family) !important;
}

/* ==========================================================================
   14. ALERTAS / INFO / WARNING
   ========================================================================== */

[data-testid="stAlert"] {
    border-radius: var(--radius-lg) !important;
    border: 1px solid var(--border) !important;
    font-family: var(--font-family) !important;
    box-shadow: var(--shadow-xs);
}

/* ==========================================================================
   15. EXPANDERS
   ========================================================================== */

[data-testid="stExpander"] {
    background: var(--surface) !important;
    border: 1px solid var(--border) !important;
    border-radius: var(--radius-lg) !important;
    box-shadow: var(--shadow-xs);
    overflow: hidden;
}

[data-testid="stExpander"] summary {
    font-weight: 550;
    color: var(--text-primary) !important;
}

[data-testid="stExpander"] summary:hover {
    background: var(--surface-hover);
}

/* ==========================================================================
   16. SEPARADORES
   ========================================================================== */

hr {
    border: none !important;
    border-top: 1px solid var(--border-light) !important;
    margin: 20px 0 !important;
}

/* ==========================================================================
   17. SPINNER
   ========================================================================== */

.stSpinner > div {
    border-top-color: var(--primary) !important;
}

/* ==========================================================================
   18. LINKS
   ========================================================================== */

a {
    color: var(--primary) !important;
    text-decoration: none;
    transition: color 0.15s ease;
}

a:hover {
    color: var(--primary-dark) !important;
    text-decoration: underline;
}

/* ==========================================================================
   19. SCROLLBAR
   ========================================================================== */

::-webkit-scrollbar {
    width: 7px;
    height: 7px;
}

::-webkit-scrollbar-track {
    background: var(--background);
}

::-webkit-scrollbar-thumb {
    background: #c5ced8;
    border-radius: 999px;
}

::-webkit-scrollbar-thumb:hover {
    background: #9eabb8;
}

/* ==========================================================================
   20. RESPONSIVIDADE
   ========================================================================== */

@media (max-width: 992px) {
    .block-container {
        padding-left: 1.25rem;
        padding-right: 1.25rem;
    }

    .kpi-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 768px) {
    .kpi-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
    }

    .kpi-card {
        padding: 16px;
    }

    .kpi-card .kpi-value {
        font-size: 1.55rem;
    }

    .main-header {
        padding: 18px 20px;
    }

    .main-header h1 {
        font-size: 1.35rem;
    }

    .main-header p {
        font-size: 0.86rem;
    }

    [data-testid="stTabs"] [data-baseweb="tab"] {
        padding: 7px 11px;
        font-size: 0.8rem;
    }
}

@media (max-width: 480px) {
    .block-container {
        padding-left: 0.75rem;
        padding-right: 0.75rem;
    }

    .kpi-grid {
        grid-template-columns: 1fr 1fr;
        gap: 8px;
    }

    .kpi-card {
        padding: 14px;
    }

    .kpi-card .kpi-icon {
        font-size: 1.15rem;
    }

    .kpi-card .kpi-label {
        font-size: 0.65rem;
    }

    .kpi-card .kpi-value {
        font-size: 1.3rem;
    }

    .kpi-card .kpi-sub {
        font-size: 0.68rem;
    }

    .main-header {
        padding: 16px 18px;
    }

    .main-header h1 {
        font-size: 1.2rem;
    }

    [data-testid="stTabs"] [data-baseweb="tab-list"] {
        overflow-x: auto;
    }
}

/* ==========================================================================
   21. REDUÇÃO DE MOVIMENTO
   ========================================================================== */

@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        scroll-behavior: auto !important;
        transition-duration: 0.01ms !important;
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
    }
}
